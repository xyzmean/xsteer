<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Со тринадцатого Android уведомление показывается только с разрешения. Без него служба
         работает, но человек не видит ни состояния, ни кнопки «отключить». -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- С четырнадцатого у службы на переднем плане обязан быть объявлен вид. Для туннеля
         своего вида нет, и специальный — единственный подходящий: он и заведён для случаев,
         которых остальные виды не описывают. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Камера нужна ровно для одного: прочитать QR с настройкой. Разрешение спрашивается в тот
         момент, когда человек нажал «Сканировать QR», и отказ не мешает ничему остальному. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xsteer"
        tools:targetApi="35">

        <!-- launchMode=singleTask, чтобы вторая ссылка приходила в УЖЕ ОТКРЫТОЕ окно (onNewIntent),
             а не заводила второе поверх первого: иначе человек, нажавший две ссылки подряд, получил
             бы два экрана с разной настройкой и не знал, который из них работает. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ссылка xs:// из мессенджера, почты или заметки открывается сразу здесь. Это тот же
                 доступ, что и файл конфигурации, только одной строкой: хаб выдаёт её рядом с
                 файлом при добавлении пира. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xs" />
            </intent-filter>

            <!-- «Поделиться» текстом: ссылку чаще пересылают, чем открывают, и из списка «Открыть
                 с помощью» она должна попадать сюда же. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Разрешение BIND_VPN_SERVICE выдаёт система, а не человек: оно означает «только
             система вправе привязаться к этой службе». Без него Android туннель не поднимет. -->
        <service
            android:name=".XsteerVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Туннель VPN: служба обязана жить, пока туннель поднят" />
        </service>
    </application>
</manifest>
