#!/bin/sh
# xs-quick — поднять и снять туннель xsteer по файлу конфигурации, как это делает wg-quick.
#
# ЗАЧЕМ ОН НУЖЕН, ЕСЛИ КЛИЕНТ И САМ ВСЁ УМЕЕТ. Клиент действительно ставит адрес, MTU, серверы
# имён и маршруты сам — обвязка ему для этого не нужна. Нужна она ровно для двух вещей, которых
# клиент не делает НАМЕРЕННО:
#
#   1. Ключи-крючки (PreUp, PostUp, PreDown, PostDown) и Table. Разбор конфигурации их
#      ОТВЕРГАЕТ, и это правильно: клиент не исполняет команды из файла, который может прийти от
#      кого угодно. Но человеку они нужны — правило firewall, свой resolver, отметка в журнале.
#      Поэтому крючки исполняет обвязка, а клиент получает файл, из которого они вырезаны. Ровно
#      такое же разделение труда у wg-quick: `wg setconf` про PostUp тоже ничего не знает.
#   2. Слежение за процессом. Клиент работает на переднем плане до отмены; xs-quick заводит его
#      в фоне, помнит номер процесса и умеет снять туннель по имени.
#
# ПОЧЕМУ ФАЙЛ ДЛЯ КЛИЕНТА ЛЕЖИТ В /run, А НЕ РЯДОМ. Вырезанный файл содержит приватный ключ,
# поэтому он создаётся с правами 0600 в /run (это tmpfs: после перезагрузки его нет вовсе). Класть
# его рядом с исходным значило бы оставить на диске второй экземпляр секрета, о котором человек не
# знает.
#
# ЧЕГО ЭТА ОБВЯЗКА НЕ ДЕЛАЕТ. Она не перезапускает упавший туннель: это работа системы, а не
# скрипта. Для этого есть xs-quick@.service рядом — но и он поднимает заново не сам, а средствами
# systemd (см. комментарий в юните).
set -eu

PREFIX=${XS_PREFIX:-/usr/local/sbin}
BIN=${XSTEER_BIN:-$PREFIX/xsteer}
CONFDIR=${XS_CONFDIR:-/etc/xsteer}
RUNDIR=${XS_RUNDIR:-/run/xsteer}

RED=''; GREEN=''; NC=''
if [ -t 1 ]; then RED='\033[0;31m'; GREEN='\033[0;32m'; NC='\033[0m'; fi

die() { printf "${RED}xs-quick: %s${NC}\n" "$1" >&2; exit 1; }
say() { printf "xs-quick: %s\n" "$1"; }

usage() {
	cat <<'EOF'
xs-quick — поднять и снять туннель xsteer по файлу конфигурации

    xs-quick up   <имя|путь>   поднять туннель
    xs-quick down <имя|путь>   снять туннель
    xs-quick restart <имя>     снять и поднять заново
    xs-quick status [имя]      что происходит (без имени — про все поднятые)
    xs-quick strip <имя|путь>  напечатать конфигурацию без ключей-крючков

Имя без косой черты берётся как /etc/xsteer/<имя>.conf; иначе это путь к файлу. Если файла .conf
нет, а рядом лежит <имя>.link — берётся он: ссылка xs:// это тот же доступ одной строкой.

Ключи-крючки исполняет xs-quick, а не клиент: PreUp, PostUp, PreDown, PostDown. В них
подставляется %i — имя туннеля. Table = off означает «маршруты не трогать».

    systemctl enable --now xs-quick@home    поднимать при загрузке
EOF
}

# ---- разбор имени и путей ---------------------------------------------------

resolve() { # resolve <имя|путь> [optional] — заполняет CONF, NAME, PIDFILE, STATE, STRIPPED
	case "$1" in
	*/*) CONF="$1"; NAME="$(basename "$1")"; NAME="${NAME%.conf}"; NAME="${NAME%.link}" ;;
	*)   NAME="$1"; CONF="$CONFDIR/$NAME.conf" ;;
	esac
	# ССЫЛКА xs:// ВМЕСТО ФАЙЛА. Хаб выдаёт доступ и файлом, и ссылкой; человек, положивший в
	# /etc/xsteer только ссылку, не должен получать «нет файла .conf» — он положил то же самое.
	#
	# Ссылка превращается в конфигурацию НА ПОДЪЁМЕ (cmd_up), а не здесь: resolve зовут и status, и
	# down, и создавать им файлы незачем. Здесь только запоминаем, откуда брать.
	LINK=""
	if [ ! -f "$CONF" ]; then
		case "$1" in
		*.link) [ -f "$1" ] && LINK="$1" ;;
		*/*)    : ;;
		*)      [ -f "$CONFDIR/$NAME.link" ] && LINK="$CONFDIR/$NAME.link" ;;
		esac
	fi
	# Имя становится именем сетевого устройства, а у него предел в 15 символов и узкий набор
	# допустимых знаков. Проверяем здесь: иначе отказ придёт от ядра и будет невнятным.
	case "$NAME" in
	''|*[!A-Za-z0-9_.-]*) die "имя туннеля «$NAME»: только буквы, цифры, дефис, точка и подчёркивание" ;;
	esac
	[ "${#NAME}" -le 15 ] || die "имя туннеля «$NAME» длиннее 15 знаков — устройство с таким именем ядро не создаст"
	# Файл конфигурации обязателен НЕ ВСЕГДА: status рассказывает о процессе и состоянии, а они
	# живут в /run. Требовать конфигурацию и там значило бы «про этот туннель ничего не скажу,
	# потому что его файл переехал» — при живом и работающем туннеле.
	if [ "${2:-}" != optional ] && [ ! -f "$CONF" ] && [ -z "$LINK" ]; then
		die "нет ни файла $CONF, ни ссылки ${CONF%.conf}.link"
	fi
	PIDFILE="$RUNDIR/$NAME.pid"
	STATE="$RUNDIR/$NAME.json"
	STRIPPED="$RUNDIR/$NAME.conf"
}

# ---- крючки и вырезание -----------------------------------------------------
#
# Один проход awk и там, и там: два разных разбора одного файла однажды разойдутся, и разойдутся
# молча — крючок исполнится не от того значения, которое увидел клиент.

hooks_of() { # hooks_of <файл> <ключ> -> строки команд по одной на строку
	awk -v want="$(printf '%s' "$2" | tr 'A-Z' 'a-z')" '
		{ line = $0; sub(/#.*/, "", line) }
		{ i = index(line, "=") }
		i > 0 {
			key = substr(line, 1, i - 1); val = substr(line, i + 1)
			gsub(/^[ \t]+|[ \t]+$/, "", key); gsub(/^[ \t]+|[ \t]+$/, "", val)
			if (tolower(key) == want && val != "") print val
		}
	' "$1"
}

table_of() { hooks_of "$1" Table | tail -1; }

strip_conf() { # strip_conf <файл> — печатает конфигурацию без ключей, которые клиент отвергает
	awk '
		{ line = $0; probe = line; sub(/#.*/, "", probe); i = index(probe, "=") }
		i > 0 {
			key = substr(probe, 1, i - 1); gsub(/^[ \t]+|[ \t]+$/, "", key); key = tolower(key)
			if (key == "preup" || key == "postup" || key == "predown" || key == "postdown" ||
			    key == "table" || key == "fwmark" || key == "saveconfig") next
		}
		{ print }
	' "$1"
}

run_hooks() { # run_hooks <файл> <ключ> <имя>
	hooks_of "$1" "$2" | while IFS= read -r cmd; do
		[ -n "$cmd" ] || continue
		cmd=$(printf '%s' "$cmd" | sed "s/%i/$3/g")
		say "$2: $cmd"
		# Крючок исполняется оболочкой, как в wg-quick: в нём бывают конвейеры и подстановки.
		# Отказ крючка НЕ рушит подъём: правило firewall могло уже стоять, и падать из-за этого
		# значило бы оставить человека без туннеля из-за пустяка. Но сказать о нём обязаны.
		sh -c "$cmd" || printf "${RED}xs-quick: %s дал ошибку (продолжаю)${NC}\n" "$2" >&2
	done
}

# ---- подъём и снятие --------------------------------------------------------

running() { # running -> 0, если процесс этого туннеля жив
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null || echo)
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	return 0
}

cmd_up() {
	resolve "$1"
	[ -x "$BIN" ] || die "нет $BIN (переопределяется переменной XSTEER_BIN)"
	running && die "туннель $NAME уже поднят (номер процесса $(cat "$PIDFILE"))"

	# Проверяем ВЫРЕЗАННЫЙ файл до всякой работы: крючки, исполненные перед отказом разбора,
	# пришлось бы откатывать вручную.
	mkdir -p "$RUNDIR"; chmod 0700 "$RUNDIR"
	if [ -n "$LINK" ]; then
		# Ссылка превращается в конфигурацию тем же клиентом, что её читает: своего разбора здесь
		# нет и быть не должно — два разбора одного формата однажды разойдутся молча.
		#
		# Ссылка идёт СО СТАНДАРТНОГО ВВОДА, а не аргументом: в ней приватный ключ, а аргументы
		# команды видны в списке процессов всякому на машине.
		( umask 077; "$BIN" conf - < "$LINK" > "$STRIPPED" 2>/dev/null ) ||
			{ rm -f "$STRIPPED"; die "ссылка $LINK не разобралась (подробности: $BIN conf - < $LINK)"; }
		CONF="$LINK"
		say "конфигурация взята из ссылки $LINK"
	else
		( umask 077; strip_conf "$CONF" > "$STRIPPED" )
	fi
	"$BIN" check "$STRIPPED" >/dev/null || { rm -f "$STRIPPED"; die "конфигурация $CONF не проходит проверку (подробности: $BIN check $STRIPPED)"; }

	run_hooks "$CONF" PreUp "$NAME"

	set -- "$BIN" up "$STRIPPED" --dev "$NAME" --state "$STATE"
	# Table = off — единственное значение, которое имеет смысл: клиент либо ставит маршруты, либо
	# нет. Числовых таблиц он не знает, и делать вид, что знает, нельзя.
	case "$(table_of "$CONF")" in
	off|no|none) set -- "$@" --no-routes; say "Table = off — маршруты не трогаю" ;;
	''|auto) : ;;
	*) die "Table принимает только off или auto: своими таблицами маршрутизации клиент не распоряжается" ;;
	esac

	# ОТВЯЗКА ОТ НАШИХ ДЕСКРИПТОРОВ ОБЯЗАТЕЛЬНА, а не гигиенична. Фоновый процесс, унаследовавший
	# stdout вызывающего, держит его открытым, пока живёт, — то есть всякий, кто читает наш вывод
	# (systemd, ssh, чужой скрипт, подстановка команды), ждёт вечно. Первая версия этого скрипта
	# так и висела, и нашлось это живым прогоном, а не рассуждением.
	#
	# НОМЕР ПРОЦЕССА ПИШЕТ САМ КЛИЕНТ, через exec: оболочка кладёт свой $$ и тут же заменяется
	# клиентом, поэтому записанное число — номер именно клиента. Брать $! нельзя: там окажется
	# номер setsid или промежуточной оболочки, а kill по нему оставил бы клиента работать — то
	# есть «снял туннель» означало бы «забыл про туннель».
	#
	# setsid — чтобы туннель не умер вместе с оболочкой, из которой его подняли (закрыли терминал,
	# отвалился ssh). Журнал идёт в файл рядом: syslog через конвейер потребовал бы отказаться от
	# exec, а с ним и от надёжного номера процесса.
	rm -f "$PIDFILE"
	setsid sh -c 'echo $$ >"$1"; shift; exec "$@"' -- "$PIDFILE" "$@" \
		</dev/null >>"$RUNDIR/$NAME.log" 2>&1 &

	# Ждём появления номера: его пишет уже отвязанная оболочка, и до записи убивать нечего.
	i=0
	while [ ! -s "$PIDFILE" ] && [ "$i" -lt 25 ]; do i=$((i + 1)); sleep 0.2; done
	[ -s "$PIDFILE" ] || { rm -f "$STRIPPED"; die "клиент не запустился — смотрите $RUNDIR/$NAME.log"; }
	pid=$(cat "$PIDFILE")

	# Ждём доказательства подъёма, а не «команда вернулась»: клиент поднимается за доли секунды,
	# но рукопожатие с хабом занимает круг обмена, и сказать «поднят» раньше значило бы соврать.
	i=0
	while [ "$i" -lt 50 ]; do
		if ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$PIDFILE" "$STRIPPED"
			die "клиент вышел сразу — смотрите $RUNDIR/$NAME.log"
		fi
		if [ -s "$STATE" ] && grep -q '"up":true' "$STATE" 2>/dev/null; then break; fi
		i=$((i + 1)); sleep 0.2
	done

	run_hooks "$CONF" PostUp "$NAME"
	if [ -s "$STATE" ] && grep -q '"up":true' "$STATE" 2>/dev/null; then
		printf "${GREEN}xs-quick: туннель %s поднят${NC}\n" "$NAME"
	else
		# НЕ отказ: пир за NAT поднимается, когда хаб ответит, и это может занять больше десяти
		# секунд на плохой сети. Но молчать нельзя — иначе «поднят» означало бы «процесс живёт».
		say "процесс $NAME работает, но рукопожатия ещё нет — смотрите xs-quick status $NAME"
	fi
}

cmd_down() {
	resolve "$1"
	running || { say "туннель $NAME не поднят"; rm -f "$PIDFILE"; return 0; }
	pid=$(cat "$PIDFILE")

	run_hooks "$CONF" PreDown "$NAME"

	# TERM, а не KILL: клиент по нему снимает маршруты, правило против RST и устройство. KILL
	# оставил бы всё это в системе — именно та беда, из-за которой в клиенте появился отдельный
	# срок на закрытие.
	kill -TERM "$pid" 2>/dev/null || true
	i=0
	while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do i=$((i + 1)); sleep 0.2; done
	if kill -0 "$pid" 2>/dev/null; then
		say "клиент не вышел за 10 с — добиваю"
		kill -KILL "$pid" 2>/dev/null || true
	fi
	rm -f "$PIDFILE" "$STRIPPED" "$STATE"

	run_hooks "$CONF" PostDown "$NAME"
	printf "${GREEN}xs-quick: туннель %s снят${NC}\n" "$NAME"
}

cmd_status() {
	if [ $# -eq 0 ]; then
		[ -d "$RUNDIR" ] || { say "поднятых туннелей нет"; return 0; }
		found=0
		for f in "$RUNDIR"/*.pid; do
			[ -e "$f" ] || continue
			found=1
			n="$(basename "$f")"; cmd_status "${n%.pid}"; echo
		done
		[ "$found" = 1 ] || say "поднятых туннелей нет"
		return 0
	fi
	resolve "$1" optional
	if running; then
		printf "%s: работает (процесс %s)\n" "$NAME" "$(cat "$PIDFILE")"
	else
		printf "%s: не работает\n" "$NAME"
	fi
	[ -s "$STATE" ] && "$BIN" show "$STATE" 2>/dev/null | sed 's/^/  /' || true
}

[ $# -ge 1 ] || { usage; exit 1; }
action="$1"; shift
case "$action" in
up)      [ $# -eq 1 ] || die "нужно одно имя туннеля"; cmd_up "$1" ;;
down)    [ $# -eq 1 ] || die "нужно одно имя туннеля"; cmd_down "$1" ;;
restart) [ $# -eq 1 ] || die "нужно одно имя туннеля"; cmd_down "$1"; cmd_up "$1" ;;
status)  cmd_status "$@" ;;
strip)   [ $# -eq 1 ] || die "нужно одно имя туннеля"; resolve "$1"; strip_conf "$CONF" ;;
-h|--help|help) usage ;;
*) die "неизвестное действие «$action» (подсказка: xs-quick --help)" ;;
esac
