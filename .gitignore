# Собранное
/xsteer
/dist/
*.exe
*.test

# Локальные конфигурации: приватный ключ в истории — это чужой пир в вашей звезде
*.conf
!*.conf.example

# Собранные двоичные файлы: место им в релизах, а не в истории
/build/

# Сборка под iOS. Ни одно из этого не принадлежит истории: XCFramework собирается из Go,
# файл проекта Xcode — из project.yml, а local.xcconfig у каждого свой (там группа
# разработчика, и записанная в историю она ломала бы сборку у всех остальных).
/mobile/build/
/ios/build/
/ios/Xsteer.xcodeproj/
/ios/Support/local.xcconfig

# Сборка под Android: библиотека собирается из Go, остальное — Gradle.
/android/tunnel/libs/*.aar
/android/tunnel/libs/*.jar
/android/build/
/android/ui/build/
/android/tunnel/build/
/android/.gradle/
/android/local.properties

# Образцы настроек в стендах приложения — НЕ секреты, а входные данные разбора. Без этого
# исключения правило «*.conf» выше выбросило бы их из истории, и стенды разбора не собрались бы
# ни у кого, кроме того, у кого они лежат на диске.
!/android/tunnel/src/test/resources/*.conf
