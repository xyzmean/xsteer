# Собранное
/xsteer
/dist/
*.exe
*.test

# Локальные конфигурации: приватный ключ в истории — это чужой пир в вашей звезде
*.conf
!*.conf.example

# Собранные двоичные файлы: место им в релизах, а не в истории
/build/

# Сборка под iOS. Ни одно из этого не принадлежит истории: XCFramework собирается из Go,
# файл проекта Xcode — из project.yml, а local.xcconfig у каждого свой (там группа
# разработчика, и записанная в историю она ломала бы сборку у всех остальных).
/mobile/build/
/ios/build/
/ios/Xsteer.xcodeproj/
/ios/Support/local.xcconfig
